rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }

    // Perfil e dados pessoais: só a própria pessoa lê e escreve.
    match /users/{uid}/{document=**} {
      allow read, write: if logado() && request.auth.uid == uid;
    }

    // Planos: quem montou edita; a pessoa que estuda (pelo e-mail) lê e registra o progresso.
    match /plans/{planId} {
      function plano() { return get(/databases/$(database)/documents/plans/$(planId)).data; }
      function ehDono() { return logado() && plano().ownerUid == request.auth.uid; }
      function ehAluno() { return logado() && plano().studentEmail == request.auth.token.email; }

      allow create: if logado() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if logado() && (resource.data.ownerUid == request.auth.uid
                               || resource.data.studentEmail == request.auth.token.email);
      allow update, delete: if logado() && resource.data.ownerUid == request.auth.uid;

      match /{document=**} {
        allow read, write: if ehDono() || ehAluno();
      }
    }

    // Todo o resto é bloqueado.
  }
}
